<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ панель</title>
</head>

<body>

    <table class="badges">
        <h1>Таблица бейджиков</h1>
        <thead>
            <tr>
                <th>Айди</th>
                <th>Название</th>
                <th>Переменная</th>
                <th>Тип</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            <% badges.forEach(badge=> { %>
                <tr>
                    <td>
                        <%= badge.id%>
                    </td>
                    <td>
                        <%= badge.title%>
                    </td>
                    <td>
                        <%= badge.name %>
                    </td>
                    <td>
                        <%= badge.type %>
                    </td>
                    <td>
                        <form action="/deleteBadge/<%=badge.id%>" method="post">
                            <button type="submit">Удалить</button>
                        </form>
                        <button id="change"
                            onclick="window.location.href=`/adminPanel/badge/<%=badge.id%>`">Изменить</button>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

    <table id="users">
        <h1>Таблица пользователей</h1>
        <thead>
            <tr>
                <th>Айди</th>
                <th>Ник</th>
                <th>Статус</th>
                <th>Левел</th>
                <th>прочитано глав</th>
                <th>аватар</th>
                <th>почта</th>
                <th>пароль</th>
                <th>действия</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user=> { %>
                <tr>
                    <th><%=user.id%></th>
                    <th><%=user.nickname%></th>
                    <th><%=user.status.title%></th>
                    <th><%=user.level%></th>
                    <th><%=user.chaptersReaded%></th>
                    <th><%=user.avatar%></th>
                    <th><%=user.email%></th>
                    <th><%=user.password%></th>
                    <th>
                        <form action="/deleteUser/<%=user.id%>" method="post">
                            <button type="submit">Удалить</button>
                        </form>
                        <button id="change"
                            onclick="window.location.href=`/adminPanel/user/<%=user.id%>`">Изменить</button>
                    </th>
                </tr>
                <%})%>
        </tbody>
    </table>

    <h1>Изменение <%=thingToChangeName%></h1>
    <% if(thingToChangeName=="badge" ){ %>
        <form action="/changeBadge" method="post" style="display: flex; flex-direction: column; gap: 10px;">
            <input type="number" name="badgeId" id="" value="<%= thingToChange.id %>">
            <input type="text" name="badgeName" id="" value="<%=thingToChange.name%>">
            <input type="text" name="badgeTitle" id="" value="<%=thingToChange.title%>">
            <input type="text" name="badgeType" id="" value="<%=  thingToChange.type %>">
            <button type="submit">Изменить</button>
        </form>
        <% } else if (thingToChangeName=="user" ){ %>
            <form action="/changeUser" method="post" style="display: flex; flex-direction: column; gap: 10px;">
                <input type="number" name="userId" id="" value="<%= thingToChange.id %>">
                <input type="text" name="userNickname" id="" value="<%=thingToChange.nickname%>">
                <select name="userStatusId" id="">
                    <option value="1" <%if(thingToChange.statusId == 1){%> selected <%}%>>Читатель</option>
                    <option value="2" <%if(thingToChange.statusId == 2){%> selected <%}%>>Редактор</option>
                    <option value="3" <%if(thingToChange.statusId == 3){%> selected <%}%>>Администратор</option>
                </select>
                <input type="number" name="userLevel" id="" value="<%=  thingToChange.level %>">
                <input type="number" name="userChaptersReaded" id="" value="<%=  thingToChange.chaptersReaded %>">
                <input type="text" name="userAvatar" id="" value="<%=  thingToChange.avatar %>">
                <input type="text" name="userEmail" id="" value="<%=  thingToChange.email %>">
                <input type="text" name="userPassword" id="" value="<%=  thingToChange.password %>">
                <button type="submit">Изменить</button>
            </form>
            <%}%>
</body>

</html>