        </div>
    </footer>

    <button id="scrollToTop" style="display: none;">↑</button>

    <div id="scroll-overlay"></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Apply wheel scrolling to all manga containers
            const containers = document.querySelectorAll('.mangasRead, .mangasBest, .mangasRecomended');

            containers.forEach(container => {
                // Wheel support
                container.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    container.scrollLeft += e.deltaY * 3; // adjust speed
                });
            });

            // Infinite loop for all containers that have duplicated content
            containers.forEach(container => {
                container.addEventListener('scroll', () => {
                    const thirdWidth = container.scrollWidth / 3;
                    if (container.scrollLeft >= thirdWidth * 2) {
                        container.scrollLeft = thirdWidth;
                    } else if (container.scrollLeft <= 0) {
                        container.scrollLeft = thirdWidth;
                    }
                });
            });

            // Snap to center functionality for all manga containers
            containers.forEach(container => {
                let scrollTimeout;

                container.addEventListener('scroll', () => {
                    clearTimeout(scrollTimeout);
                    scrollTimeout = setTimeout(() => {
                        snapToCenter(container);
                    }, 40); // Wait 40ms after scroll stops
                });
            });

            function snapToCenter(container) {
                const containerRect = container.getBoundingClientRect();
                const containerCenter = containerRect.left + containerRect.width / 2;
                const mangaItems = container.querySelectorAll('.manga');

                let closestItem = null;
                let minDistance = Infinity;

                mangaItems.forEach(item => {
                    const itemRect = item.getBoundingClientRect();
                    const itemCenter = itemRect.left + itemRect.width / 2;
                    const distance = Math.abs(containerCenter - itemCenter);

                    if (distance < minDistance) {
                        minDistance = distance;
                        closestItem = item;
                    }
                });

                if (closestItem) {
                    const itemRect = closestItem.getBoundingClientRect();
                    const itemCenter = itemRect.left + itemRect.width / 2;
                    const scrollLeft = container.scrollLeft + (itemCenter - containerCenter);

                    container.scrollTo({
                        left: scrollLeft,
                        behavior: 'smooth'
                    });
                }
            }

            // Smooth scrolling with blur effect for links
            function smoothScrollTo(element, duration = 1700, callback) {
                const targetPosition = element.getBoundingClientRect().top + window.pageYOffset;
                const startPosition = window.pageYOffset;
                const distance = targetPosition - startPosition;
                let startTime = null;

                function animation(currentTime) {
                    if (startTime === null) startTime = currentTime;
                    const timeElapsed = currentTime - startTime;
                    const run = ease(timeElapsed, startPosition, distance, duration);
                    window.scrollTo(0, run);
                    if (timeElapsed < duration) {
                        requestAnimationFrame(animation);
                    } else {
                        if (callback) callback();
                    }
                }

                function ease(t, b, c, d) {
                    t /= d / 2;
                    if (t < 1) return c / 2 * t * t * t + b;
                    t -= 2;
                    return c / 2 * (t * t * t + 2) + b;
                }

                requestAnimationFrame(animation);
            }

            const links = document.querySelectorAll('.links a');
            links.forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const targetId = link.getAttribute('href');
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        document.documentElement.classList.add('scrolling');
                        smoothScrollTo(targetElement, 1600, () => {
                            setTimeout(() => {
                                document.documentElement.classList.remove('scrolling');
                            }, 90);
                        });
                    }
                });
            });

            // Auto-scroll functionality for sliders
            const mangasRead = document.querySelector('.mangasRead');
            const mangasBest = document.querySelector('.mangasBest');
            const mangasRecomended = document.querySelector('.mangasRecomended');

            // Store intervals for each container
            const intervals = [null, null, null];
            const intervalsData = [
                { container: mangasRead, time: 5000 },
                { container: mangasBest, time: 6000 },
                { container: mangasRecomended, time: 7000 }
            ];

            // Function to auto-scroll a container
            function autoScroll(container, interval, index) {
                return setInterval(() => {
                    const scrollAmount = 244; // 220px (manga width) + 24px (gap)
                    container.scrollLeft += scrollAmount;

                    // Reset to middle section when reaching the end for infinite effect
                    const thirdWidth = container.scrollWidth / 3;
                    if (container.scrollLeft >= thirdWidth * 2) {
                        container.scrollLeft = thirdWidth;
                    }
                }, interval);
            }

            // Start auto-scrolling for all containers
            intervalsData.forEach((data, index) => {
                intervals[index] = autoScroll(data.container, data.time, index);
            });

            // Pause auto-scroll on hover and resume on mouse leave
            containers.forEach((container, index) => {
                container.addEventListener('mouseenter', () => {
                    clearInterval(intervals[index]);
                    intervals[index] = null;
                });

                container.addEventListener('mouseleave', () => {
                    if (!intervals[index]) {
                        intervals[index] = autoScroll(container, intervalsData[index].time, index);
                    }
                });
            });

            // Scroll to top button functionality
            const scrollToTopBtn = document.getElementById('scrollToTop');

            window.addEventListener('scroll', () => {
                if (window.scrollY > 100) {
                    scrollToTopBtn.style.display = 'block';
                } else {
                    scrollToTopBtn.style.display = 'none';
                }
            });

            scrollToTopBtn.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        });
    </script>

</body>

</html>