                    </div>
                    <% }); %>
                        <% mangasRead.forEach(manga=> { %>
                            <div class="manga">
                                <img src="<%= manga.imgUrl %>" alt="">
                                <div class="text">
                                    <h2>
                                        <%= manga.title %>
                                    </h2>
                                    <p>
                                        <%= manga.tag[0].tag %>
                                    </p>
                                </div>
                            </div>
                            <% }); %>
                                <% mangasRead.forEach(manga=> { %>
